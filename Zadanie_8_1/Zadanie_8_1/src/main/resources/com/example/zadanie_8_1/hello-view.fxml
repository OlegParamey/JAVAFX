<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<StackPane prefHeight="400.0" prefWidth="600.0"
           xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.zadanie_8_1.HelloController">

  <VBox spacing="8">
    <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

    <HBox spacing="4">
      <Label text="Enter current year (in numbers)" style="-fx-font-size: 16px; -fx-font-weight:bold"/>
      <Label fx:id="textFieldLabel"/>
    </HBox>
    <TextField fx:id="textFieldQuestion" maxWidth="250" />

    <HBox spacing="4">
      <Label text="Which layout element is used to place items horizontally" style="-fx-font-size: 16px; -fx-font-weight:bold"/>
      <Label fx:id="comboBoxLabel"/>
    </HBox>
    <ComboBox fx:id="comboBoxQuestion" maxWidth="250" />

    <HBox spacing="4">
      <Label text="Which Layout Classes can be used to display items vertically?" style="-fx-font-size: 16px; -fx-font-weight:bold"/>
      <Label fx:id="checkBoxLabel"/>
    </HBox>
    <CheckBox text="A - VBox" fx:id="cbA"/>
    <CheckBox text="B - HBox" fx:id="cbB"/>
    <CheckBox text="C - FlowPane" fx:id="cbC"/>

    <HBox spacing="4">
    <Label text="Which record is used to link action to Button" style="-fx-font-size: 16px; -fx-font-weight:bold" />
      <Label fx:id="radioBtnLabel"/>
    </HBox>
    <RadioButton text='A - onAction="#checkTest"' fx:id="rbA"/>
    <RadioButton text='B - onClick="#checkTest"' fx:id="rbB"/>
    <RadioButton text='C - onPress="#checkTest"' fx:id="rbC"/>

    <StackPane style="-fx-background-color: #fff;">
      <HBox spacing="8" alignment="CENTER">
        <Label text="Test results:" style="-fx-font-size: 24px" />
        <Label fx:id="results" />
      </HBox>
    </StackPane>

    <HBox alignment="CENTER" spacing="10">
      <Button text="Check" onAction="#checkTest"/>
      <Button text="Exit" fx:id="exitButton" onAction="#closeApp"/>
    </HBox>

  </VBox>

</StackPane>
